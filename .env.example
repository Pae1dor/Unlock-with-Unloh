# Postgres (production / docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/islamapp

# Zero-dependency local trial (no docker needed) — use this instead:
# DATABASE_URL=sqlite:///./dev.db

# Change this in production. Used to sign the JWT stored in the access_token cookie.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default city used for prayer times / Hijri date when the visitor has not picked one
DEFAULT_CITY=กรุงเทพมหานคร
