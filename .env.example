# Copy to .env and fill in real values. .env is never committed.

# Local run with .\dev.ps1 (no docker needed): SQLite file in the project folder.
DATABASE_URL=sqlite:///./dev.db

# docker compose: password of the "db" container. The app's DATABASE_URL is built
# from it inside docker-compose.yml, so the DATABASE_URL above is ignored there.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Change this in production. Used to sign the JWT stored in the access_token cookie.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default city used for prayer times / Hijri date when the visitor has not picked one
DEFAULT_CITY=กรุงเทพมหานคร
